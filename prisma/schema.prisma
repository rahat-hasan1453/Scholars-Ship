// Prisma Schema for HighScholar Portal
// Matches PRD: Users, UserProfiles, Scholarships, Professors, Applications, Tasks

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DegreeLevel {
  BACHELORS
  MASTERS
  PHD
}

enum ApplicationStatus {
  WISHLIST
  PREPARING
  SUBMITTED
  UNDER_REVIEW
  DECIDED
}

enum DecisionResult {
  PENDING
  ACCEPTED
  REJECTED
  WAITLISTED
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  name                String
  avatar              String?
  googleId            String?      @unique
  onboardingCompleted Boolean      @default(false)
  profileData         Json?
  emailVerifiedAt     DateTime?
  passwordHash        String? // scrypt; null for Google-only or code-only accounts
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  profile             UserProfile?
}

// One pending email sign-in code per address; only the SHA-256 hash is stored.
model LoginCode {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Fixed-window counters for rate limiting. key = "<scope>:<subject>", e.g. "verify:email:a@b.c".
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model UserProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  degreeLevel     DegreeLevel
  specializations String[]
  targetCountries String[]
  cgpa            Decimal?
  testScores      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  followedProfs   ProfFollow[]
  savedPapers     SavedPaper[]
}

model Scholarship {
  id               String        @id @default(uuid())
  title            String
  provider         String
  deadline         DateTime
  fundingAmount    String
  fundingType      String        @default("FULL")
  degreeLevels     DegreeLevel[]
  countries        String[]
  specializations  String[]
  requirementsJson Json?
  admissionSummary String?
  livingCost       String?
  /// Short provider name for the facts grid, e.g. "DAAD"
  providerShort    String?
  /// Field of study line for the facts grid
  fieldOfStudy     String?
  /// [{ label, value }] rows for the Funding section
  fundingBreakdown Json?
  applySteps       String[]      @default([])
  tags             String[]      @default([])
  officialUrl      String
  description      String
  featured         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
}

model University {
  id         String        @id @default(uuid())
  name       String
  country    String
  city       String?
  website    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  labs       ResearchLab[]
  professors Professor[]

  @@unique([name, country])
}

// Faculty & Research Labs card (Figma 251:22151): lab bar, Financial, Target Terms, chips
model ResearchLab {
  id                String        @id @default(uuid())
  name              String
  universityId      String
  university        University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  department        String?
  website           String?
  researchTags      String[]
  openPositions     Boolean       @default(true)
  fundingSummary    String? // "Merit-Based Scholarships + $1,500/mo Graduate Assistantship"
  fundingType       String        @default("FULL") // FULL | PARTIAL, same as Scholarship.fundingType
  fundingSource     String? // "German Academic Exchange Service (DAAD)"
  degreeLevels      DegreeLevel[]
  acceptingTerms    String[]
  // Details page "Lab at a Glance" (Figma 258:3622); null = unknown, row is hidden
  phdStudents       Int?
  postdocs          Int?
  openPositionCount Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  professors        Professor[]
  grants            Grant[]

  @@unique([universityId, name])
}

// Research funding won by a lab or professor ("Recent grant" on the Faculty details page).
// Later filled by the grant-signal pipeline (NSF, NIH, UKRI, CORDIS).
model Grant {
  id          String       @id
  title       String
  funder      String?
  /// Display amount with currency, e.g. "SEK 4.2M"
  amount      String
  year        Int?
  labId       String?
  lab         ResearchLab? @relation(fields: [labId], references: [id], onDelete: SetNull)
  professorId String?
  professor   Professor?   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([professorId])
}

model Professor {
  id               String        @id @default(uuid())
  name             String
  title            String
  // Plain-text copies stay until the data pipeline links every row to University / ResearchLab
  university       String
  department       String
  country          String
  universityId     String?
  universityRef    University?   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  labId            String?
  lab              ResearchLab?  @relation(fields: [labId], references: [id], onDelete: SetNull)
  labName          String?
  researchTags     String[]
  openPositions    Boolean       @default(true)
  recentGrants     String?
  email            String?
  linkedInUrl      String?
  googleScholar    String?
  labWebsite       String?
  avatarUrl        String?
  acceptingTerms   String[]
  // Faculty details page (Figma 258:3503)
  /// School or faculty inside the university, e.g. "School of EECS"
  school           String?
  bio              String?
  publicationCount Int?
  hIndex           Int?
  /// { degree, minCgpa?, minIelts?, minToefl?, experience?, publications } for "What They Look For"
  lookingFor       Json?
  contactSteps     String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  followers        ProfFollow[]
  grants           Grant[]
  papers           PaperAuthor[]
  opportunities    Opportunity[]
}

// Opportunity Feed: a funded position posted by a professor or lab.
// List card: Figma 212:6186 · Details page: Figma 258:3269
model Opportunity {
  id              String        @id
  title           String
  authorName      String
  authorTitle     String
  authorAvatar    String?
  /// Set when the author matches a seeded Professor row by name
  professorId     String?
  professor       Professor?    @relation(fields: [professorId], references: [id], onDelete: SetNull)
  institution     String
  labName         String?
  country         String
  city            String?
  /// linkedin | twitter | lab_website | web | reddit
  source          String
  sourceUrl       String
  postedAt        DateTime
  content         String
  funding         String
  /// Values from the Acceptance & Funding filter, e.g. "Full Funding"
  fundingTags     String[]
  degreeLevels    DegreeLevel[]
  fieldTags       String[]
  /// Values from the Subject filter, e.g. "HCI"
  subjectTags     String[]
  minCgpa         Float?
  minIelts        Float?
  /// "none" | "preferred" | "required"
  publications    String        @default("none")
  // List card lines
  admission       String
  livingCost      String
  rankRange       String
  acceptanceRate  Int
  // Details page
  positionType    String
  startDate       String
  deadline        DateTime
  /// [{ label, value }] rows for the Position Details section
  positionDetails Json
  aboutLab        String
  applySteps      String[]      @default([])
  contactEmail    String?
  officialUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([country])
}

model ProfFollow {
  id          String      @id @default(uuid())
  profileId   String
  professorId String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professor   Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([profileId, professorId])
}

// Research Paper card (Figma 251:23294): title, abstract, authors, citations, field chips, Scholar + PDF
model ResearchPaper {
  id                String        @id @default(uuid())
  title             String
  abstract          String
  year              Int?
  publishedAt       DateTime?
  venue             String?
  citationCount     Int           @default(0)
  doi               String?       @unique
  semanticScholarId String?       @unique
  pdfUrl            String?
  googleScholarUrl  String?
  fieldsOfStudy     String[]
  tags              String[]
  isOpenAccess      Boolean       @default(false)
  // Details modal (Figma 261:3390). Unknown values stay null and their rows are hidden.
  venueShort        String? // "CHI 2025"
  paperType         String? // "Conference paper" | "Journal article" | "Preprint"
  peerReviewed      Boolean?
  institution       String? // lead institution, shown in Facts
  funding           String? // "NSF IIS-2214567"
  keyFindings       Json? // [{ label, text, value, met }]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  authors           PaperAuthor[]
  savedBy           SavedPaper[]
}

// Ordered author list; professorId is set when the author is a known Professor
model PaperAuthor {
  id          String        @id @default(uuid())
  paperId     String
  paper       ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  position    Int
  name        String
  institution String?
  professorId String?
  professor   Professor?    @relation(fields: [professorId], references: [id], onDelete: SetNull)

  @@unique([paperId, position])
  @@index([professorId])
}

model SavedPaper {
  id        String        @id @default(uuid())
  profileId String
  paperId   String
  profile   UserProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([profileId, paperId])
}

model Application {
  id            String            @id @default(uuid())
  profileId     String
  scholarshipId String
  status        ApplicationStatus @default(WISHLIST)
  decision      DecisionResult    @default(PENDING)
  notes         String?
  deadline      DateTime?
  orderIndex    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       UserProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scholarship   Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  tasks         ApplicationTask[]
}

model ApplicationTask {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  isCompleted   Boolean     @default(false)
  dueDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
