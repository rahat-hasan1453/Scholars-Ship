# ========================================================
# HighScholar Environment Configuration
# ========================================================

# Application URL (Default for local development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sign-in method for the whole site: "password" (default: email + password, email verified once
# with a code at sign-up) or "code" (a 5-digit code emailed on every sign-in). Google works in both.
# Changing it needs a redeploy.
NEXT_PUBLIC_AUTH_METHOD="password"

# Signs the login session cookie. Required in production (at least 32 characters).
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# --------------------------------------------------------
# 1. Google OAuth 2.0 Credentials (FREE)
# --------------------------------------------------------
# How to get them:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project (e.g., "HighScholar")
# 3. Go to "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID"
# 4. Choose "Web application"
# 5. Add Authorized redirect URI:
#    http://localhost:3000/api/auth/callback/google
#    (For production, add https://yourdomain.com/api/auth/callback/google)
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------------------
# 2. Database Connection (PostgreSQL - FREE)
# --------------------------------------------------------
# You can use a free cloud PostgreSQL database like Neon (https://neon.tech),
# Supabase (https://supabase.com), or your local PostgreSQL server.
# Example: postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/highscholar?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/highscholar?schema=public"

# --------------------------------------------------------
# 3. Email Service for Real OTP Delivery (FREE)
# --------------------------------------------------------
# Option A: Gmail SMTP (Easiest & Free)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail address and the 16-character App Password below:
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_FROM="HighScholar <your-email@gmail.com>"

# Option B: Resend (https://resend.com - 3000 free emails/mo)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="HighScholar <onboarding@resend.dev>"
