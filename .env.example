# ========================================================
# HighScholar Environment Configuration
# ========================================================

# Application URL (Default for local development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# 1. Google OAuth 2.0 Credentials (FREE)
# --------------------------------------------------------
# How to get them:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project (e.g., "HighScholar")
# 3. Go to "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID"
# 4. Choose "Web application"
# 5. Add Authorized redirect URI:
#    http://localhost:3000/api/auth/callback/google
#    (For production, add https://yourdomain.com/api/auth/callback/google)
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------------------
# 2. Database Connection (PostgreSQL - FREE)
# --------------------------------------------------------
# You can use a free cloud PostgreSQL database like Neon (https://neon.tech),
# Supabase (https://supabase.com), or your local PostgreSQL server.
# Example: postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/highscholar?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/highscholar?schema=public"
